# ============================================================
# Meeting Intelligence Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to source control.
# ============================================================

# --- Google Cloud Project ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# --- Service Account Key (for DWD + GCS) ---
# Path inside the container as set in Dockerfile / Cloud Run Job
GOOGLE_APPLICATION_CREDENTIALS=/app/service_account.json

# --- Google Workspace ---
# Super-admin email that the service account impersonates via DWD
ADMIN_EMAIL=admin@yourdomain.com

# --- 3CX Recordings Bucket ---
GCS_BUCKET_NAME=your-3cx-recordings-bucket

# --- Google Sheets ---
# The ID from the Sheets URL: /spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your-spreadsheet-id

# --- Email ---
# All department reports are sent FROM this address (must match DWD subject)
EMAIL_SENDER=admin@yourdomain.com
# Master consolidated report recipient — never CC'd on department emails
MASTER_REPORT_RECIPIENT=admin@example.com
# Optional secondary recipient for the master report
MASTER_REPORT_CC=

# --- Executive Privacy Filter ---
# Comma-separated extensions / phone numbers / emails. Calls touching any of
# these are routed to an isolated executive-only report.
EXECUTIVE_IDENTIFIERS=100,+15550000000,executive@example.com

# --- AI Models (optional overrides) ---
PRIMARY_AI_MODEL=gemini-2.5-flash
ESCALATION_AI_MODEL=gemini-2.5-pro

# --- 3CX V20 API (optional contact lookup) ---
# Leave blank to skip contact enrichment.
3CX_API_URL=https://your-pbx.example.com:5001
TCX_CLIENT_ID=
TCX_CLIENT_SECRET=

# --- Lookback Window ---
# How many hours back to scan for new meetings/calls (default 24)
LOOKBACK_HOURS=24

# Hours offset from UTC used for report timestamps (e.g. 4 for UTC+4)
TIMEZONE_OFFSET=0
